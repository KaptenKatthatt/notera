{
  "$schema": "https://raw.githubusercontent.com/KaptenKatthatt/notera/master/theme.schema.json",
  // Notera's own look. Every other built-in theme and every new theme starts from these keys.
  "name": { "en": "Default", "sv": "Standard" },
  "light": {
    "colors": {
      "editor.background": "#ffffff",
      "editor.foreground": "#222324",
      "editorGroupHeader.tabsBackground": "#f4f4f3",
      "list.hoverBackground": "#e8e8e8",
      "tab.activeBackground": "#ffffff",
      "editorWidget.background": "#ffffff",
      "descriptionForeground": "#6b6b6b",
      "panel.border": "#dcdcdc",
      "button.background": "#0067c0",
      "button.foreground": "#ffffff",
      "editor.selectionBackground": "#0067c0",
      "editor.selectionForeground": "#ffffff",
      "editor.lineHighlightBackground": "#f6f8fa",
      "textCodeBlock.background": "#f8f8f8",
      "widget.shadow": "rgba(0, 0, 0, 0.16)",
      "input.background": "#fffef2",
      "editor.findMatchHighlightBackground": "#ffe58a",
      "editor.findMatchBackground": "#cf8000",
      "list.activeSelectionBackground": "rgba(0, 103, 192, 0.12)",
      "errorForeground": "#c42b1c",
      "editor.rangeHighlightBackground": "#fff1a8"
    },
    "notera": {
      "colors": { "heading": "#222324", "link": "#2077b2", "quote": "#6e7074", "code": "#8b3a00", "markup": "#6e7074" }
    }
  },
  "dark": {
    "colors": {
      "editor.background": "#101010",
      "editor.foreground": "#eeeeee",
      "editorGroupHeader.tabsBackground": "#1c1c1c",
      "list.hoverBackground": "#2c2c2c",
      "tab.activeBackground": "#101010",
      "editorWidget.background": "#232323",
      "descriptionForeground": "#a0a0a0",
      "panel.border": "#333333",
      "button.background": "#4cc2ff",
      "button.foreground": "#002b45",
      "editor.selectionBackground": "#0067c0",
      "editor.selectionForeground": "#ffffff",
      "editor.lineHighlightBackground": "#161616",
      "textCodeBlock.background": "#1c1a1a",
      "widget.shadow": "rgba(0, 0, 0, 0.5)",
      "input.background": "#22221f",
      "editor.findMatchHighlightBackground": "#725b18",
      "editor.findMatchBackground": "#a05900",
      "list.activeSelectionBackground": "rgba(76, 194, 255, 0.16)",
      "errorForeground": "#ff99a4",
      "editor.rangeHighlightBackground": "#5a4a10"
    },
    "notera": {
      "colors": { "heading": "#eeeeee", "link": "#5584aa", "quote": "#80838a", "code": "#f0a36b", "markup": "#80838a" }
    }
  }
}
