{
  "$schema": "https://raw.githubusercontent.com/KaptenKatthatt/notera/master/theme.schema.json",
  // Codex. Near-black or white with neutral greys, primary buttons in the text colour, cyan for
  // code and links the way the CLI prints them, and a magenta nod on the unsaved dot.
  "name": "The Other guys",
  "style": "style.css",
  "notera": {
    "fonts": { "ui": ["Segoe UI Variable", "Segoe UI", "Selawik", "system-ui", "-apple-system", "Helvetica Neue", "Arial", "sans-serif"] }
  },
  "dark": {
    "colors": {
      "editor.background": "#111111",
      "editor.foreground": "#ececec",
      "editorGroupHeader.tabsBackground": "#181818",
      "list.hoverBackground": "#262626",
      "tab.activeBackground": "#111111",
      "editorWidget.background": "#1c1c1c",
      "descriptionForeground": "#8f8f8f",
      "panel.border": "#2a2a2a",
      "button.background": "#ececec",
      "button.foreground": "#111111",
      "editor.selectionBackground": "#636363",
      "editor.selectionForeground": "#ececec",
      "editor.lineHighlightBackground": "#161616",
      "textCodeBlock.background": "#1c1c1c",
      "widget.shadow": "rgba(0, 0, 0, 0.6)",
      "input.background": "#1c1c1c",
      "editor.findMatchHighlightBackground": "rgba(94, 196, 214, 0.25)",
      "editor.findMatchBackground": "#007485",
      "editorCursor.foreground": "#ffffff",
      "list.activeSelectionBackground": "rgba(255, 255, 255, 0.08)",
      "errorForeground": "#ff7b72",
      "editor.rangeHighlightBackground": "#3a3a3a",
      "tab.activeModifiedBorder": "#d38aea"
    },
    "notera": {
      "colors": { "heading": "#ffffff", "link": "#5ec4d6", "quote": "#8f8f8f", "code": "#5ec4d6", "markup": "#828282" }
    }
  },
  "light": {
    "colors": {
      "editor.background": "#ffffff",
      "editor.foreground": "#0d0d0d",
      "editorGroupHeader.tabsBackground": "#f7f7f7",
      "list.hoverBackground": "#ececec",
      "tab.activeBackground": "#ffffff",
      "editorWidget.background": "#ffffff",
      "descriptionForeground": "#6e6e6e",
      "panel.border": "#e5e5e5",
      "button.background": "#0d0d0d",
      "button.foreground": "#ffffff",
      "editor.selectionBackground": "#057d92",
      "editor.selectionForeground": "#ffffff",
      "editor.lineHighlightBackground": "#f7f7f7",
      "textCodeBlock.background": "#f5f5f5",
      "widget.shadow": "rgba(0, 0, 0, 0.12)",
      "input.background": "#ffffff",
      "editor.findMatchHighlightBackground": "rgba(10, 127, 148, 0.18)",
      "editor.findMatchBackground": "#349fb1",
      "editor.findMatchForeground": "#0d0d0d",
      "editorCursor.foreground": "#0d0d0d",
      "list.activeSelectionBackground": "rgba(0, 0, 0, 0.06)",
      "errorForeground": "#d1242f",
      "editor.rangeHighlightBackground": "#e8e8e8",
      "tab.activeModifiedBorder": "#b44fd1"
    },
    "notera": {
      "colors": { "heading": "#000000", "link": "#007a8f", "quote": "#6e6e6e", "code": "#007a8f", "markup": "#6f6f6f" }
    }
  }
}
