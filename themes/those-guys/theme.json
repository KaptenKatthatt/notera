{
  "$schema": "https://raw.githubusercontent.com/KaptenKatthatt/notera/master/theme.schema.json",
  // Claude Code. Dark: Claude's warm near-black, its orange, and the periwinkle it uses for code
  // and suggestions. Light: the cream of claude.ai with the same orange. A terminal font for the
  // chrome and a serif for reading.
  "name": "Those guys",
  "style": "style.css",
  "notera": {
    "fonts": { "ui": ["Cascadia Mono", "Consolas", "iA Writer Mono S", "monospace"] }
  },
  "read": {
    "fonts": { "body": ["Tiempos Text", "Charter", "Georgia", "Cambria", "serif"] }
  },
  "dark": {
    "colors": {
      "editor.background": "#262624",
      "editor.foreground": "#faf9f5",
      "editorGroupHeader.tabsBackground": "#1f1e1d",
      "list.hoverBackground": "#30302e",
      "tab.activeBackground": "#262624",
      "editorWidget.background": "#30302e",
      "descriptionForeground": "#a6a39a",
      "panel.border": "#3d3d3a",
      "button.background": "#d77757",
      "button.foreground": "#1f1e1d",
      "editor.selectionBackground": "rgba(215, 119, 87, 0.3)",
      "editor.lineHighlightBackground": "#2b2b29",
      "textCodeBlock.background": "#1f1e1d",
      "widget.shadow": "rgba(0, 0, 0, 0.55)",
      "input.background": "#262624",
      "editor.findMatchHighlightBackground": "rgba(177, 185, 249, 0.3)",
      "editor.findMatchBackground": "rgba(215, 119, 87, 0.6)",
      "editorCursor.foreground": "#d77757",
      "list.activeSelectionBackground": "rgba(215, 119, 87, 0.16)",
      "errorForeground": "#ff6b80",
      "editor.rangeHighlightBackground": "#5c3a2c",
      "editorWidget.border": "#6b6a65"
    },
    "notera": {
      "colors": { "heading": "#d77757", "link": "#b1b9f9", "quote": "#999999", "code": "#b1b9f9", "markup": "#6b6a65" }
    }
  },
  "light": {
    "colors": {
      "editor.background": "#faf9f5",
      "editor.foreground": "#141413",
      "editorGroupHeader.tabsBackground": "#f0eee6",
      "list.hoverBackground": "#e8e6dc",
      "tab.activeBackground": "#faf9f5",
      "editorWidget.background": "#ffffff",
      "descriptionForeground": "#73726c",
      "panel.border": "#dedcd1",
      "button.background": "#c6613f",
      "button.foreground": "#ffffff",
      "editor.selectionBackground": "rgba(217, 119, 87, 0.22)",
      "editor.lineHighlightBackground": "#f3f1ea",
      "textCodeBlock.background": "#f0eee6",
      "widget.shadow": "rgba(60, 50, 30, 0.14)",
      "input.background": "#ffffff",
      "editor.findMatchHighlightBackground": "rgba(87, 103, 208, 0.22)",
      "editor.findMatchBackground": "rgba(217, 119, 87, 0.45)",
      "editorCursor.foreground": "#c6613f",
      "list.activeSelectionBackground": "rgba(217, 119, 87, 0.14)",
      "errorForeground": "#c62a47",
      "editor.rangeHighlightBackground": "#f3d9cc",
      "editorWidget.border": "#c9c6b8"
    },
    "notera": {
      "colors": { "heading": "#c6613f", "link": "#5767d0", "quote": "#87867f", "code": "#5767d0", "markup": "#b0aea5" }
    }
  }
}
