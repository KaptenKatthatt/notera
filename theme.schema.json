{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/KaptenKatthatt/notera/master/theme.schema.json",
  "title": "Notera theme",
  "description": "A Notera theme (theme.json). See THEMES.md.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "description": "The name shown in the Theme menu. A string, or a map of language code to string.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "extends": {
      "description": "Id (folder name) of the theme this one builds on. Its values are the starting point; this file's values win.",
      "type": "string"
    },
    "style": {
      "description": "A CSS file in the theme folder, loaded after Notera's own styles while the theme is active.",
      "type": "string"
    },
    "fonts": {
      "description": "Font files in the theme folder, usable by family name in notera.fonts and style.css.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family",
          "src"
        ],
        "properties": {
          "family": {
            "type": "string"
          },
          "src": {
            "description": "Path inside the theme folder, e.g. fonts/Orbitron.ttf",
            "type": "string"
          },
          "weight": {
            "description": "A weight or a range, e.g. \"400\" or \"400 900\"",
            "type": [
              "string",
              "number"
            ]
          },
          "style": {
            "enum": [
              "normal",
              "italic"
            ]
          }
        }
      }
    },
    "colors": {
      "$ref": "#/definitions/colors"
    },
    "tokenColors": {
      "$ref": "#/definitions/tokenColors"
    },
    "notera": {
      "$ref": "#/definitions/notera"
    },
    "read": {
      "$ref": "#/definitions/read"
    },
    "light": {
      "$ref": "#/definitions/variant",
      "description": "Values for the Light mode, merged over the shared ones."
    },
    "dark": {
      "$ref": "#/definitions/variant",
      "description": "Values for the Dark mode, merged over the shared ones."
    },
    "importedFrom": {
      "description": "Set by Import VS Code theme: the extension and the themes this file came from.",
      "type": "object",
      "properties": {
        "extension": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "color": {
      "type": "string",
      "description": "Any CSS colour: #rrggbb, #rrggbbaa, rgb(), rgba(), a named colour."
    },
    "fontList": {
      "description": "A font family, or a list tried in order.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "colors": {
      "description": "VS Code workbench colour keys. Notera reads the ones listed here; any other key is ignored, so a VS Code theme's colors block can be pasted in whole.",
      "type": "object",
      "properties": {
        "editor.background": {
          "$ref": "#/definitions/color"
        },
        "editor.foreground": {
          "$ref": "#/definitions/color"
        },
        "foreground": {
          "$ref": "#/definitions/color"
        },
        "editorGroupHeader.tabsBackground": {
          "$ref": "#/definitions/color",
          "description": "Tab bar, toolbar and status bar."
        },
        "sideBar.background": {
          "$ref": "#/definitions/color"
        },
        "titleBar.activeBackground": {
          "$ref": "#/definitions/color"
        },
        "list.hoverBackground": {
          "$ref": "#/definitions/color"
        },
        "toolbar.hoverBackground": {
          "$ref": "#/definitions/color"
        },
        "tab.activeBackground": {
          "$ref": "#/definitions/color"
        },
        "tab.activeModifiedBorder": {
          "$ref": "#/definitions/color",
          "description": "The unsaved-changes dot on a tab."
        },
        "editorWidget.background": {
          "$ref": "#/definitions/color",
          "description": "Menus, dialogs and popups."
        },
        "editorWidget.border": {
          "$ref": "#/definitions/color"
        },
        "menu.background": {
          "$ref": "#/definitions/color"
        },
        "quickInput.background": {
          "$ref": "#/definitions/color"
        },
        "descriptionForeground": {
          "$ref": "#/definitions/color",
          "description": "Muted text."
        },
        "tab.inactiveForeground": {
          "$ref": "#/definitions/color"
        },
        "panel.border": {
          "$ref": "#/definitions/color"
        },
        "editorGroup.border": {
          "$ref": "#/definitions/color"
        },
        "sideBar.border": {
          "$ref": "#/definitions/color"
        },
        "contrastBorder": {
          "$ref": "#/definitions/color"
        },
        "button.background": {
          "$ref": "#/definitions/color",
          "description": "The accent: primary buttons, the active view button, focus."
        },
        "button.foreground": {
          "$ref": "#/definitions/color"
        },
        "focusBorder": {
          "$ref": "#/definitions/color"
        },
        "textLink.foreground": {
          "$ref": "#/definitions/color"
        },
        "editor.selectionBackground": {
          "$ref": "#/definitions/color"
        },
        "editor.selectionForeground": {
          "$ref": "#/definitions/color",
          "description": "The colour selected text is drawn in. Default: the text colour."
        },
        "editor.lineHighlightBackground": {
          "$ref": "#/definitions/color"
        },
        "textCodeBlock.background": {
          "$ref": "#/definitions/color"
        },
        "textPreformat.background": {
          "$ref": "#/definitions/color"
        },
        "textPreformat.foreground": {
          "$ref": "#/definitions/color"
        },
        "textBlockQuote.foreground": {
          "$ref": "#/definitions/color"
        },
        "editorCursor.foreground": {
          "$ref": "#/definitions/color"
        },
        "list.activeSelectionBackground": {
          "$ref": "#/definitions/color",
          "description": "The open note in the sidebar."
        },
        "list.inactiveSelectionBackground": {
          "$ref": "#/definitions/color"
        },
        "errorForeground": {
          "$ref": "#/definitions/color"
        },
        "editorError.foreground": {
          "$ref": "#/definitions/color"
        },
        "input.border": {
          "$ref": "#/definitions/color",
          "description": "The border of text fields. Default: 58 % text colour over the background."
        },
        "editor.findMatchForeground": {
          "$ref": "#/definitions/color",
          "description": "The text of the current search hit."
        },
        "editor.findMatchHighlightForeground": {
          "$ref": "#/definitions/color",
          "description": "The text of the other search hits."
        },
        "input.background": {
          "$ref": "#/definitions/color",
          "description": "The search panel."
        },
        "editor.findMatchHighlightBackground": {
          "$ref": "#/definitions/color"
        },
        "editor.findMatchBackground": {
          "$ref": "#/definitions/color"
        },
        "editor.rangeHighlightBackground": {
          "$ref": "#/definitions/color",
          "description": "The flash on a moved note in the sidebar."
        },
        "widget.shadow": {
          "$ref": "#/definitions/color"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "tokenColors": {
      "description": "VS Code tokenColors. Notera reads the Markdown scopes (markup.heading, markup.quote, markup.inline.raw, markup.underline.link, punctuation.definition) for headings, quotes, code, links and Markdown markers.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "settings": {
            "type": "object",
            "properties": {
              "foreground": {
                "$ref": "#/definitions/color"
              }
            }
          }
        }
      }
    },
    "notera": {
      "description": "What VS Code themes do not have: Markdown and heading colours, fonts and effects.",
      "type": "object",
      "properties": {
        "colors": {
          "type": "object",
          "properties": {
            "heading": {
              "$ref": "#/definitions/color"
            },
            "link": {
              "$ref": "#/definitions/color"
            },
            "quote": {
              "$ref": "#/definitions/color"
            },
            "code": {
              "$ref": "#/definitions/color"
            },
            "markup": {
              "$ref": "#/definitions/color",
              "description": "Markdown markers: #, **, >, ```."
            },
            "heading1": {
              "$ref": "#/definitions/color",
              "description": "H1 colour"
            },
            "heading2": {
              "$ref": "#/definitions/color",
              "description": "H2 colour"
            },
            "heading3": {
              "$ref": "#/definitions/color",
              "description": "H3 colour"
            },
            "heading4": {
              "$ref": "#/definitions/color",
              "description": "H4 colour"
            },
            "heading5": {
              "$ref": "#/definitions/color",
              "description": "H5 colour"
            },
            "heading6": {
              "$ref": "#/definitions/color",
              "description": "H6 colour"
            }
          },
          "additionalProperties": {
            "$ref": "#/definitions/color"
          }
        },
        "fonts": {
          "type": "object",
          "properties": {
            "ui": {
              "$ref": "#/definitions/fontList",
              "description": "Menus, tabs, toolbar, status bar and the preview."
            },
            "editor": {
              "$ref": "#/definitions/fontList",
              "description": "The editor. Overrides the font chosen in Settings while the theme is active."
            },
            "headings": {
              "$ref": "#/definitions/fontList",
              "description": "Headings, in the editor and the preview."
            },
            "heading1": {
              "$ref": "#/definitions/fontList",
              "description": "The H1, if it should differ from the other headings."
            }
          },
          "additionalProperties": {
            "$ref": "#/definitions/fontList"
          }
        },
        "effects": {
          "$ref": "#/definitions/effects"
        },
        "lineHeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 3,
          "description": "Line height in the editor, e.g. 1.75 for an airy writing theme. Default 1.4.",
          "default": 1.4
        }
      },
      "additionalProperties": true
    },
    "read": {
      "description": "Overrides for the preview (L\u00e4s).",
      "type": "object",
      "properties": {
        "fonts": {
          "type": "object",
          "properties": {
            "body": {
              "$ref": "#/definitions/fontList"
            },
            "headings": {
              "$ref": "#/definitions/fontList"
            }
          },
          "additionalProperties": {
            "$ref": "#/definitions/fontList"
          }
        },
        "effects": {
          "$ref": "#/definitions/effects",
          "description": "Effects in L\u00e4s, merged over notera.effects."
        },
        "lineHeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 3,
          "description": "Line height in L\u00e4s. Default 1.6.",
          "default": 1.6
        }
      },
      "additionalProperties": true
    },
    "variant": {
      "type": "object",
      "properties": {
        "colors": {
          "$ref": "#/definitions/colors"
        },
        "tokenColors": {
          "$ref": "#/definitions/tokenColors"
        },
        "notera": {
          "$ref": "#/definitions/notera"
        },
        "read": {
          "$ref": "#/definitions/read"
        }
      }
    },
    "effects": {
      "description": "Built-in effects. Each is off unless set; false turns off an inherited one. See THEMES.md.",
      "type": "object",
      "properties": {
        "glow": {
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "properties": {
                "target": {
                  "enum": [
                    "headings",
                    "all"
                  ]
                },
                "strength": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "color": {
                  "$ref": "#/definitions/color"
                }
              }
            }
          ]
        },
        "gradient": {
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "properties": {
                "colors": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/color"
                  },
                  "minItems": 2
                },
                "levels": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 6
                  }
                }
              }
            }
          ]
        },
        "cursor": {
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "properties": {
                "style": {
                  "enum": [
                    "line",
                    "block",
                    "underline"
                  ]
                },
                "glow": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "smooth": {
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "typing": {
          "description": "The cursor effect this theme suggests. The user's choice in Settings wins; \"none\" suggests none.",
          "enum": [
            "none",
            "sparks",
            "pixie",
            "ripple",
            "pulse",
            "phosphor",
            "phosphorTrail",
            "laser",
            "sight",
            "neon",
            "glitch",
            "focus"
          ]
        },
        "sparks": {
          "description": "Sparks fly up from the cursor at every key. Its parameters; the effect runs when it is the cursor effect (typing).",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "amount": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 40,
                  "default": 10
                },
                "size": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 8,
                  "default": 2.5
                },
                "colors": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/color"
                  }
                }
              }
            }
          ]
        },
        "pixie": {
          "description": "Two or three small dots drift down from the baseline and fade. Its parameters; the effect runs when it is the cursor effect (typing).",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "colors": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/color"
                  }
                }
              }
            }
          ]
        },
        "ripple": {
          "description": "A thin ring grows out of the cursor and fades. Its parameters; the effect runs when it is the cursor effect (typing).",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "colors": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/color"
                  }
                }
              }
            }
          ]
        },
        "pulse": {
          "description": "The cursor's glow flares up at every key and dies down. Its parameters; the effect runs when it is the cursor effect (typing).",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "color": {
                  "$ref": "#/definitions/color"
                }
              }
            }
          ]
        },
        "phosphor": {
          "description": "The letter just typed flashes and settles to its normal colour and glow, like CRT phosphor. Its parameters; the effect runs when it is the cursor effect (typing).",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "color": {
                  "$ref": "#/definitions/color"
                },
                "strength": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 1
                }
              }
            }
          ]
        },
        "phosphorTrail": {
          "description": "The phosphor letter, and a fading streak from where the cursor was to where it went. Its parameters; the effect runs when it is the cursor effect (typing).",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "color": {
                  "$ref": "#/definitions/color"
                },
                "strength": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 1
                },
                "trailColor": {
                  "$ref": "#/definitions/color"
                },
                "trailOpacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0.55
                }
              }
            }
          ]
        },
        "laser": {
          "description": "A red laser beam from the right hits the cursor and burns the letter in. Its parameters; the effect runs when it is the cursor effect (typing).",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "color": {
                  "$ref": "#/definitions/color"
                }
              }
            }
          ]
        },
        "sight": {
          "description": "A thin red laser line flashes along the line under the baseline. Its parameters; the effect runs when it is the cursor effect (typing).",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "color": {
                  "$ref": "#/definitions/color"
                }
              }
            }
          ]
        },
        "neon": {
          "description": "The letter lights up like a neon tube: it flickers before it burns steadily. Its parameters; the effect runs when it is the cursor effect (typing).",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          ]
        },
        "glitch": {
          "description": "A red and a cyan copy of the letter jump apart and slide back together. Its parameters; the effect runs when it is the cursor effect (typing).",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          ]
        },
        "focus": {
          "description": "The letter lands large and blurred and pulls together sharp. Its parameters; the effect runs when it is the cursor effect (typing).",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          ]
        },
        "particles": {
          "description": "Before 0.11: sparks. Read as the sparks parameters, and as the suggestion when typing is not set.",
          "deprecated": true,
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 40
                },
                "colors": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/color"
                  }
                },
                "size": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 8
                }
              }
            }
          ]
        },
        "trail": {
          "description": "Before 0.11: a streak behind the moving cursor. No longer drawn.",
          "deprecated": true
        },
        "background": {
          "type": "object",
          "properties": {
            "grid": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "properties": {
                    "color": {
                      "$ref": "#/definitions/color"
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "speed": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              ]
            },
            "sun": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "properties": {
                    "colors": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/color"
                      }
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              ]
            },
            "scanlines": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "vignette": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  }
}
