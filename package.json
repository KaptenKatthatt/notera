{
  "name": "notera",
  "productName": "Notera",
  "version": "0.4.2",
  "description": "A streamlined Markdown and plain-text notepad for Windows",
  "author": "Jonas Olson",
  "license": "MIT",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "build:renderer": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "npm run build:renderer && electron .",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "e2e": "node scripts/build.mjs && node test/e2e/smoke.mjs && node test/e2e/tabs.mjs && node test/e2e/writing.mjs && node test/e2e/lines.mjs && node test/e2e/settings.mjs && node test/e2e/update.mjs",
    "icon": "electron scripts/make-icon.js",
    "dist:win": "node scripts/build.mjs --prod && electron-builder --win --x64 --publish never",
    "dist:dir": "node scripts/build.mjs --prod && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "marked": "^18.0.14",
    "playwright": "^1.63.0",
    "png-to-ico": "^3.0.2"
  },
  "homepage": "https://github.com/KaptenKatthatt/notera",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
